# Copy to .env and fill in ONE of these.
#
# Fastest / free option: GROQ_API_KEY (genuinely free tier, no credit card,
# ever — sign up at console.groq.com). If set, groundskeeper uses it
# automatically in preference to everything below (see ai_backends.py).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Otherwise, same config format as training_data_bot (paid):
TDB_AI_PROVIDER=anthropic

ANTHROPIC_API_KEY=
TDB_ANTHROPIC_MODEL=claude-sonnet-5

OPENAI_API_KEY=
TDB_OPENAI_MODEL=gpt-4o-mini

# Keep these small — the dataset used for evaluation is deliberately tiny
# (see docs/REPRODUCTION.md for exact cost/runtime observed).
TDB_CHUNK_SIZE_TOKENS=400
TDB_CHUNK_OVERLAP_TOKENS=50
